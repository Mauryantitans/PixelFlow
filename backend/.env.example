# Application Settings
DEBUG=False
APP_NAME=PixelFlow
VERSION=1.1.0

# Server Settings
HOST=0.0.0.0
PORT=8000

# Image Storage
# Options: filesystem (traditional), database (recommended for persistence)
IMAGE_STORAGE=database

# Database Settings
# For PostgreSQL (Production):
DATABASE_URL=postgresql://username:password@localhost:5432/pixelflow
USE_SQLITE=False

# For SQLite (Development):
# USE_SQLITE=True

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth cookies (httpOnly cookie-based auth). Defaults are fine for local dev
# (Secure off under DEBUG, SameSite=Lax). In production set COOKIE_SECURE=True and
# serve the frontend same-origin with the API (see deployment/DEPLOYMENT_GUIDE.md).
# COOKIE_SECURE=True
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# CORS Origins (comma-separated). NOTE: the env var is ALLOWED_ORIGINS.
ALLOWED_ORIGINS=http://localhost:3000
# For production, add your frontend domain:
# ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
# Optional regex for Vercel preview URLs:
# ALLOWED_ORIGINS_REGEX=https://your-app(-[a-z0-9]+)*\.vercel\.app

# Google OAuth (Optional - uncomment and configure if using)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# For production, update redirect URI:
# GOOGLE_REDIRECT_URI=https://your-frontend-domain.com/auth/google/callback

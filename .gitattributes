# --- Frontend (React) ---
frontend/**/*.ts linguist-language=TypeScript
frontend/**/*.tsx linguist-language=TypeScript
frontend/**/*.js linguist-language=TypeScript
frontend/**/*.jsx linguist-language=TypeScript
frontend/**/*.css linguist-language=CSS

# --- Backend (FastAPI) ---
backend/**/*.py linguist-language=Python

# --- Ignore build / vendor artifacts ---
frontend/node_modules/** linguist-vendored
frontend/build/** linguist-vendored
frontend/dist/** linguist-vendored
backend/__pycache__/** linguist-vendored
backend/venv/** linguist-vendored
